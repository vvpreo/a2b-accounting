#!/usr/bin/env bash
#
# a2b-finances-update — установка/обновление A2B Finances до свежей `latest`-сборки.
#
# Запускается НА MAC-ХОСТЕ (не в DevBox). Скачивает rolling-релиз `latest`
# из приватного репозитория через gh CLI, ставит .app в /Applications,
# снимает карантин и Gatekeeper-блокировку («сразу со всеми разрешениями»).
#
# Положите этот файл в каталог из $PATH (или добавьте scripts/to-path в PATH),
# сделайте исполняемым (chmod +x) и запускайте просто:
#
#     a2b-finances-update
#
set -euo pipefail

# --- Конфигурация (значения берутся из release-latest.yml / tauri.conf.json) ---
REPO="vvpreo/vvpreo-accounting"
RELEASE_TAG="latest"
DMG_PATTERN="*.dmg"
DMG_NAME="A2B-Finances-latest-arm64.dmg"
APP_NAME="A2B Finances.app"
VOLUME="/Volumes/A2B Finances"
INSTALL_DIR="/Applications"

# --- Цветной вывод ---
info()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }
die()   { printf '\033[1;31m==>\033[0m %s\n' "$*" >&2; exit 1; }

# --- Предусловия ---
[[ "$(uname -s)" == "Darwin" ]] || die "Скрипт рассчитан на macOS-хост."
command -v gh >/dev/null 2>&1 || die "Не найден gh CLI. Установите: brew install gh"
gh auth status >/dev/null 2>&1 || die "gh не авторизован. Выполните: gh auth login"

# --- Рабочая директория для скачивания (чистится на выходе) ---
WORKDIR="$(mktemp -d -t a2b-finances-update)"
cleanup() {
  # Размонтировать том, если остался смонтированным после ошибки.
  if [[ -d "$VOLUME" ]]; then
    hdiutil detach "$VOLUME" >/dev/null 2>&1 || true
  fi
  rm -rf "$WORKDIR"
}
trap cleanup EXIT

# --- 1. Скачать свежий DMG ---
info "Скачиваю релиз '$RELEASE_TAG' из $REPO …"
gh release download "$RELEASE_TAG" \
  --repo "$REPO" \
  --pattern "$DMG_PATTERN" \
  --dir "$WORKDIR" \
  --clobber

DMG_PATH="$WORKDIR/$DMG_NAME"
if [[ ! -f "$DMG_PATH" ]]; then
  # На случай, если имя ассета изменится — берём первый найденный .dmg.
  DMG_PATH="$(/bin/ls -1 "$WORKDIR"/*.dmg 2>/dev/null | head -n1 || true)"
  [[ -n "$DMG_PATH" && -f "$DMG_PATH" ]] || die "В релизе не нашёлся .dmg файл."
fi
ok "Скачано: $(basename "$DMG_PATH")"

# --- 2. Закрыть запущенное приложение (иначе copy затрёт работающий бинарь) ---
if pgrep -f "$APP_NAME/Contents/MacOS" >/dev/null 2>&1; then
  info "Закрываю запущенное приложение …"
  osascript -e 'quit app "A2B Finances"' >/dev/null 2>&1 || true
  sleep 2
  # Если не закрылось мягко — принудительно.
  pkill -f "$APP_NAME/Contents/MacOS" >/dev/null 2>&1 || true
fi

# --- 3. Смонтировать DMG ---
# Снимаем карантин с самого DMG, чтобы монтирование не упёрлось в Gatekeeper.
xattr -d com.apple.quarantine "$DMG_PATH" >/dev/null 2>&1 || true

# Если том уже примонтирован с прошлого раза — отмонтировать.
[[ -d "$VOLUME" ]] && hdiutil detach "$VOLUME" >/dev/null 2>&1 || true

info "Монтирую образ …"
hdiutil attach "$DMG_PATH" -nobrowse -quiet
[[ -d "$VOLUME/$APP_NAME" ]] || die "В образе не найден '$APP_NAME' по пути '$VOLUME'."

# --- 4. Установить в /Applications ---
info "Устанавливаю в $INSTALL_DIR …"
rm -rf "$INSTALL_DIR/$APP_NAME"
cp -R "$VOLUME/$APP_NAME" "$INSTALL_DIR/"

hdiutil detach "$VOLUME" >/dev/null 2>&1 || true

# --- 5. Снять карантин и Gatekeeper-блокировку («все разрешения») ---
info "Снимаю карантин (приложение не подписано Apple ID) …"
xattr -cr "$INSTALL_DIR/$APP_NAME" || true
# Явно добавляем в исключения Gatekeeper, чтобы не было запроса при первом запуске.
spctl --add "$INSTALL_DIR/$APP_NAME" >/dev/null 2>&1 || true

ok "Готово. A2B Finances установлена в $INSTALL_DIR."
info "Запуск: open \"$INSTALL_DIR/$APP_NAME\""
