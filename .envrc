export FINANCES_DATA_DIR="$(pwd)/data"

# Load local secrets (e.g. OPENROUTER_API_KEY) from a gitignored .env.local.
# Never commit real keys — keep them in .env.local (matched by *.local in
# .gitignore). The AI provider config references the key as
# "env:OPENROUTER_API_KEY".
dotenv_if_exists .env.local
